# Copy to .env and fill in. .env is gitignored - never commit real keys.

# Path to the extracted Ashen Era Archive (see README for download instructions).
CORPUS_PATH=data/Ashen_Era_Archive

# Google AI Studio (LLM + vision). Free tier: https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# Voyage AI (embeddings). Free tier: https://dashboard.voyageai.com
VOYAGE_API_KEY=

# Set to 'paid' once a payment card is added to the Voyage dashboard.
# The card is identity verification only - the 200M free tokens still apply
# and nothing is charged. Without it, Voyage limits a fresh account to
# 3 requests / 10,000 tokens per minute, which makes a full index build
# take ~2 hours instead of a few minutes.
VOYAGE_TIER=free

# OpenRouter (fallback LLM). Free tier: https://openrouter.ai
OPENROUTER_API_KEY=
