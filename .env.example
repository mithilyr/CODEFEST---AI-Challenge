# Copy to .env and fill in. .env is gitignored - never commit real keys.

# Path to the extracted Ashen Era Archive (see README for download instructions).
CORPUS_PATH=data/Ashen_Era_Archive

# Google AI Studio (LLM + vision). Free tier: https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# Voyage AI (embeddings). Free tier: https://dashboard.voyageai.com
VOYAGE_API_KEY=

# OpenRouter (fallback LLM). Free tier: https://openrouter.ai
OPENROUTER_API_KEY=
