# --- Secrets: never commit. Judges read full commit history. ---
.env
*.key
config/secrets.yaml

# --- Corpus: read-only competition data, ~123 MB. See README for download. ---
data/*
!data/.gitkeep

# --- Build artifacts / caches ---
# Derived data stays out, with one deliberate exception: the prebuilt Checkpoint 1
# baseline bundle (ADR-047). `.cache/index/` and `.cache/responses/` are committed
# - about 19.7 MB - so `python -m eval.run_eval --checkpoint baseline` reproduces
# 1B 2/7 and 1C 2/2 from a fresh clone with no API key at all. The rest of
# `.cache/` is rebuilt on demand; `.cache/embeddings/` alone is 82 MB and is not
# worth committing to save a five-minute rebuild.
.cache/*
!.cache/index/
!.cache/responses/
build/
*.faiss
# The baseline index's vectors are the one committed .npy - see above.
*.npy
!.cache/index/*.npy

# --- Python ---
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/

# --- OS / editor ---
.DS_Store
Thumbs.db
.vscode/
.idea/

# --- Team teaching notes: internal, not a deliverable. ---
# docs/INTERNALS.md is a from-scratch walkthrough of the whole codebase written
# for the team. It is NOT scanned by tests/test_docs.py, so its numbers can go
# stale; re-derive with the commands in its section 17 before teaching from it.
docs/INTERNALS.md
