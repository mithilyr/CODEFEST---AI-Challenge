# Normalise line endings so the repo is identical across Windows and Unix.
# The team develops on Windows; judges may run on either.
* text=auto eol=lf

# Binary assets must never be line-ending converted.
*.png binary
*.pdf binary
*.docx binary
*.zip binary
# The committed baseline index (ADR-047). float32 vectors must not be touched
# by eol conversion, and `text=auto` above would otherwise get a vote.
*.npy binary
# setup.exe (ADR-049) - a compiled Go binary, not text.
*.exe binary
