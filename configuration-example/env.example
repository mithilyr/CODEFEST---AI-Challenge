# ---------------------------------------------------------------------------
# Ashen Era Intelligence Assistant - environment template
#
# This is an annotated copy of the repository's `.env.example`. To use it:
#
#     cp .env.example .env          (from the repository root)
#
# and fill in only the keys you need. `.env` is gitignored and must never be
# committed - judges read the full commit history.
#
# THE IMPORTANT THING TO KNOW FIRST
# ---------------------------------
# The demo needs NO API KEY. Ingestion, the graph, the query engine and the
# whole demo UI are deterministic Python over committed caches. Every key below
# is optional, and each one buys exactly one thing.
# ---------------------------------------------------------------------------


# Path to the extracted Ashen Era Archive. Relative paths resolve from the
# repository root. The directory this points at must be the one that directly
# contains `chronicles/`, `codex/`, `ephemera/`, `images/` and `wiki/`.
#
# Required for: everything. This is the only variable the demo path uses.
CORPUS_PATH=data/Ashen_Era_Archive


# Google AI Studio - Gemini, used for vision (OCR) and the Checkpoint 1
# baseline's answer generation.   https://aistudio.google.com/apikey
#
# Required for: re-transcribing the 17 scanned PDFs from source images.
# NOT required to run them: all 17 transcripts are committed under `ocr_cache/`,
# so `python -m src.ingest.ocr` completes 17/17 from cache with this blank.
#
# Free tier is ~20 requests/day PER MODEL - a daily cap that backoff cannot
# recover from. `src/clients/gemini.py` rotates across 6 models for this reason.
GOOGLE_API_KEY=


# Voyage AI - embeddings for the Checkpoint 1 vector-RAG baseline.
#                                        https://dashboard.voyageai.com
#
# Required for: building the baseline vector index, which is NOT committed
# (`.cache/` is gitignored). Without it, `python -m eval.run_eval --checkpoint
# baseline` cannot run and reports that the index is missing. The graph path -
# which is what this project is actually about - does not use embeddings at all.
VOYAGE_API_KEY=


# Set to `paid` once a payment card is added to the Voyage dashboard.
# The card is identity verification only: the 200M free tokens still apply and
# nothing is charged. Without it Voyage throttles a fresh account to
# 3 requests / 10,000 tokens per minute, which turns a ~5-minute index build
# into roughly 2 hours.
VOYAGE_TIER=free


# OpenRouter - the third routing tier (LLM planner) and model phrasing.
#                                        https://openrouter.ai
#
# Required for: `python -m src.ui.server --with-model` and
# `python -m src.query.synthesis`'s model phrasing path.
#
# BOTH ARE OFF BY DEFAULT (F-025). Deterministic-first is a default, not a
# comment: no test and no evaluation sweep may spend quota or depend on a
# provider being reachable. Leave this blank and the system runs its
# deterministic path end to end.
OPENROUTER_API_KEY=
